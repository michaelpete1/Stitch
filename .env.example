# Existing account and course auth
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Chat persistence (Cloudflare D1 via its server-side API)
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-your-d1-database-id
# D1 token needs D1 Read and D1 Edit permissions.
CLOUDFLARE_D1_DATABASE_TOKEN=replace-with-a-d1-api-token
# Workers AI token needs Workers AI Read permissions. This can be the existing WORKERSAPI_KEY variable.
WORKERSAPI_KEY=replace-with-a-workers-ai-api-token

# Gemini chat generation; keep server-side (never use NEXT_PUBLIC_)
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
